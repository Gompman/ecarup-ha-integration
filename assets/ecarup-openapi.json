      "PublicApi.ChargingHistory.ChargingProvider": {
        "enum": [
          "CHARGING_PROVIDER_UNSPECIFIED",
          "CHARGING_PROVIDER_ECARUP",
          "CHARGING_PROVIDER_HUBJECT"
        ],
        "type": "string",
        "description": "The provider through which the charging was started. New values may be added in the future,\r\nclients must tolerate values they do not know.\r\n- 0: (CHARGING_PROVIDER_UNSPECIFIED, default) The provider could not be determined\r\n- 1: (CHARGING_PROVIDER_ECARUP) The charging was started through eCarUp itself\r\n- 2: (CHARGING_PROVIDER_HUBJECT) The charging was started through the Hubject roaming platform"
      },
