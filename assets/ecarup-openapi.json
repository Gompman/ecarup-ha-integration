          "name": {
            "type": "string",
            "description": "The name of the station when the charging has happened"
          },
          "connectorNumber": {
            "type": "integer",
            "description": "the number of the connector of the station",
            "format": "int32"
          },
          "ownerId": {
            "type": "integer",
