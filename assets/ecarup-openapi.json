      "PublicApi.ChargingHistory.ChargingHistoryStationPriceInformation": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "description": "The currency of the station"
          },
          "pricePerKwh": {
            "type": "number",
            "description": "The price per kWh of the station",
            "format": "double"
          },
          "pricePerH": {
            "type": "number",
            "description": "The price per Hour (time)",
            "format": "double"
          }
        },
        "additionalProperties": false
