      "PublicApi.Stations.StationsFilter": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "description": "(optional) Filter for the stations.\r\n- 0: (OwnedAndManagedAndViewed, default) Gets all stations of this user and all stations this user has management or view access to\r\n- 1: (Owned) Gets only the stations of this user\r\n- 2: (Managed) Gets only the stations of other users this user has management access to\r\n- 3: (Viewed) Gets only the stations of other users this user has view access to",
