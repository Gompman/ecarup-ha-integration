            "format": "double"
          },
          "meterActiveEnergyWh": {
            "type": "number",
            "description": "Last Energy.Active.Import.Register value the station sent in Wh",
            "format": "double"
          },
          "socPercent": {
            "type": "number",
            "description": "Last state of charge value the station sent in percent",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
