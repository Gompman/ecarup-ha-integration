{
  "openapi": "3.0.1",
  "info": {
    "title": "eCarUp API",
    "contact": {
      "name": "ecarup uses smart-me oauth provider for authentication.",
      "url": "https://doc.smart-me.com/interfaces/api#h.1p4hi8nk4xqk"
    },
    "version": "v1"
  },
  "paths": {
    "/v1/station/{stationId}/connectors/{connectorId}/active-charging": {
      "get": {
        "tags": [
          "ActiveChargingProtoService"
        ],
        "summary": "Gets the active charging session for a specific connector,\r\nincluding the station groups the station belongs to.",
        "parameters": [
          {
            "name": "stationId",
            "in": "path",
            "description": "ID of the station",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "connectorId",
            "in": "path",
            "description": "ID of the connector",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApi.ActiveChargings.ActiveChargingResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Google.Rpc.Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history/station/{id}": {
      "get": {
        "tags": [
          "ChargingHistoryProtoService"
        ],
        "summary": "Gets the charging history of a station",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paginationCursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApi.ChargingHistory.GetChargingHistoryResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Google.Rpc.Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history/driver": {
      "get": {
        "tags": [
          "ChargingHistoryProtoService"
        ],
        "summary": "Gets the charging history of this user",
        "parameters": [
          {
            "name": "paginationCursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApi.ChargingHistory.GetChargingHistoryResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Google.Rpc.Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stations": {
      "get": {
        "tags": [
          "StationProtoService"
        ],
        "summary": "Gets all stations of the user",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PublicApi.Stations.StationsFilter"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApi.Stations.GetAllStationsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Google.Rpc.Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/station/{id}": {
      "get": {
        "tags": [
          "StationProtoService"
        ],
        "summary": "Gets the details of a station",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApi.Stations.Station"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Google.Rpc.Status"
                }
              }
            }
          }
        }
      }
    }
  },
